+static bool nm_probe_official_kobo_tls() {
+    QSslSocket socket;
+    socket.setProxy(QNetworkProxy::NoProxy);
+    socket.setPeerVerifyMode(QSslSocket::VerifyPeer);
+    socket.connectToHostEncrypted(QStringLiteral("www.kobo.com"), 443);
+    const bool verified = socket.waitForEncrypted(3000) && socket.isEncrypted();
+    socket.abort();
+    return verified;
+}
+
+extern "C" __attribute__((visibility("default"))) bool _nm_qemu_real_internet_accessible(void *) {
+    return nm_qemu_official_network_ready;
+}
+
+static bool nm_qemu_patch_internet_gate() {
+    using SharedInstance = void *(*)();
+    auto sharedInstance = reinterpret_cast<SharedInstance>(
+        dlsym(RTLD_DEFAULT, "_ZN23WirelessWorkflowManager14sharedInstanceEv"));
+    void *manager = sharedInstance ? sharedInstance() : nullptr;
+    if (!manager) return false;
+
+    auto **vtable = *reinterpret_cast<void ***>(manager);
+    if (!vtable || !vtable[12]) return false;
+    auto *slot = &vtable[12];
+    const long pageSize = sysconf(_SC_PAGESIZE);
+    if (pageSize <= 0) return false;
+    const uintptr_t page = reinterpret_cast<uintptr_t>(slot) & ~uintptr_t(pageSize - 1);
+    if (mprotect(reinterpret_cast<void *>(page), pageSize, PROT_READ | PROT_WRITE) != 0)
+        return false;
+
+    void *original = *slot;
+    *slot = reinterpret_cast<void *>(&_nm_qemu_real_internet_accessible);
+    if (mprotect(reinterpret_cast<void *>(page), pageSize, PROT_READ) == 0)
+        return true;
+
+    *slot = original;
+    const bool protectionRestored = mprotect(reinterpret_cast<void *>(page), pageSize, PROT_READ) == 0;
+    NM_LOG("emulator network gate: restored original method after protection failure (%s)",
+        protectionRestored ? "read-only" : "original pointer; protection restore failed");
+    return false;
+}
+
+extern "C" __attribute__((visibility("default"))) bool _nm_qemu_wireless_connected(void *manager) {
+    static bool logged = false;
+    if (nm_qemu_wifi_connected) {
+        if (!logged) {
+            NM_LOG("emulator-only Wi-Fi state shim active; native DNS and TLS remain unchanged");
+            logged = true;
+        }
+        return true;
+    }
+    return WirelessManager_connected && WirelessManager_connected(manager);
+}
